# Local development only. Set your own local password in the ignored .env file.
POSTGRES_PASSWORD=local-development-only
INGRESS_PORT=8080
WORKER_PORT=8081

# Approved design values; availability and live access remain to be verified.
GCP_PROJECT_ID=reply-mcfly-poc
GCP_REGION=europe-west1
VERTEX_AI_LOCATION=eu
GEMINI_MODEL=gemini-3.5-flash

# Intentionally empty: no real Gmail sends until mailbox and allowlist are confirmed.
MCFLY_MAILBOX_ID=
# Allowlist: MCFLY_ALLOWED_SENDERS=["user1@gmail.com","user2@gmail.com"]
# Allow-all (only "*", never combined with addresses): MCFLY_ALLOWED_SENDERS=["*"]
MCFLY_ALLOWED_SENDERS=[]
MCFLY_GMAIL_OAUTH_SECRET_VERSION=
MCFLY_SYNC_QUEUE=sync-queue
MCFLY_PROCESS_QUEUE=process-queue
MCFLY_WORKER_URL=
MCFLY_INGRESS_AUDIENCE=
MCFLY_PUBSUB_SERVICE_ACCOUNT=
MCFLY_TASKS_SERVICE_ACCOUNT=reply-mcfly-tasks@reply-mcfly-poc.iam.gserviceaccount.com
MCFLY_GMAIL_TOPIC=projects/reply-mcfly-poc/topics/gmail-events
MCFLY_ENABLE_RAG=false
